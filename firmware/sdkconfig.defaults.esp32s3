# Wisp — ESP32-S3-Touch-AMOLED-2.16 only.
#
# SPIRAM_MODE_OCT <- the ESP32-S3R8 carries octal PSRAM; getting this wrong
#                    is a boot loop.

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# —— Memory: WiFi vs. the display's DMA ——
# The CO5300's SPI driver needs a DMA buffer in INTERNAL RAM. With the
# WiFi+lwIP stack allocating there too, internal runs out and the panel stops
# updating with "Failed to allocate priv TX buffer" / ESP_ERR_NO_MEM.
# Pushing the network buffers into PSRAM gives internal back to the display.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# —— Onde moram os objetos do LVGL ——
#
# Com LV_USE_CLIB_MALLOC, cada objeto do LVGL sai do malloc comum, e o padrao
# manda TODA alocacao menor que 16KB para a RAM interna. Objeto de interface e
# sempre menor que isso, entao o painel inteiro se aloja no recurso mais escasso
# da placa — e o painel de cartoes tem varias vezes mais objetos que o desenho
# anterior.
#
# Medido: com o padrao, a interna livre no fim do boot caiu para 7,6KB e a task
# de rede (6KB de pilha) simplesmente nao era criada. O xTaskCreate devolve
# pdFAIL em silencio, entao a placa ficava em "connecting" para sempre e parecia
# problema de WiFi.
#
# 512 bytes deixa as alocacoes miudas na interna e manda a arvore de objetos
# para a PSRAM, que e onde ha 6,5MB sobrando. Nao vale para a C6: la nao existe
# PSRAM e a opcao nem existe no Kconfig.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# TRIED AND REVERTED: touching SPIRAM_MALLOC_RESERVE_INTERNAL /
# ALWAYSINTERNAL made it worse (free internal at boot dropped from 26KB to
# 7.7KB). The cause was not allocation policy: SPI allocates a bounce buffer
# the SIZE OF THE FLUSH whenever the area's length is not cache-aligned. With
# buffer_height=50 that asks for up to 48KB contiguous. The fix is to lower the
# flush ceiling — done in main.c, registering the display with a smaller
# buffer.

